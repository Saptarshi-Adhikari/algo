# AI Quantitative Research & Paper Trading Configuration

# System parameters
APP_NAME=QuantAI-PaperTrader
DEBUG=false
DATA_DIR=./data
EXPERIMENTS_DIR=./experiments
DB_PATH=./data/experiments.db

# SAFETY CONSTRAINTS (MUST ALWAYS BE TRUE & FALSE)
PAPER_TRADING_ONLY=true
ALLOW_REAL_BROKER=false

# Default Paper Trading Execution Settings
DEFAULT_INITIAL_CASH=100000.0
DEFAULT_COMMISSION_BPS=3.0
DEFAULT_SLIPPAGE_BPS=1.0

# Data Engine Defaults
DEFAULT_MARKET=INDIAN_EQUITY
DEFAULT_DATA_MODE=HISTORICAL
DEFAULT_TIMEFRAME=1d

# LLM Layer Configuration (Local-First)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional API Fallbacks (System works 100% locally without these)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

# Experiment Loop Bounds
DEFAULT_MAX_EXPERIMENTS=10
